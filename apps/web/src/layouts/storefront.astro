---
import "@workspace/ui/globals.css"

import SiteFooter from "@/features/storefront/components/site-footer.astro"
import SiteHeader from "@/features/storefront/components/site-header.astro"
import { STORE_NAME, STORE_TAGLINE } from "@/features/storefront/content/store"

interface Props {
  title: string
  description?: string
  active?: "catalogo" | "deportivo" | "elegante" | "diario" | "contacto"
}

const { title, description = STORE_TAGLINE, active } = Astro.props

const fullTitle = `${title} · ${STORE_NAME}`
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={STORE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <SiteHeader active={active} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
