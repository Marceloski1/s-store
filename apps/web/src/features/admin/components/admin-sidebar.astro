---
import { ExternalLinkIcon } from "@workspace/ui/components/icons/external-link"
import { LayersIcon } from "@workspace/ui/components/icons/layers"
import { LogoutIcon } from "@workspace/ui/components/icons/logout"
import { ShoeIcon } from "@workspace/ui/components/icons/shoe"
import { UsersIcon } from "@workspace/ui/components/icons/users"

import { initialsOf, navFor, AdminSection } from "@/features/admin/content/nav"
import { LOGOUT_PATH, ROLE_LABELS } from "@/features/auth/api/permissions"
import { STORE_NAME } from "@/features/storefront/content/store"

interface Props {
  active: AdminSection
}

const { active } = Astro.props
const user = Astro.locals.user
---

<aside
  class="hidden flex-col justify-between bg-sidebar py-6 text-sidebar-foreground lg:flex"
>
  <div class="flex flex-col gap-7">
    <div class="flex flex-col gap-1 px-6">
      <span
        class="font-display text-2xl leading-none font-extrabold tracking-[0.2em] text-sidebar-accent-foreground"
      >
        {STORE_NAME}
      </span>
      <span
        class="text-[10px] font-extrabold tracking-[0.2em] uppercase opacity-60"
      >
        Panel de gestión
      </span>
    </div>

    <nav class="flex flex-col gap-0.5" aria-label="Secciones del panel">
      {
        navFor(user).map((item) => (
          <a
            href={item.href}
            aria-current={item.section === active ? "page" : undefined}
            class:list={[
              "flex h-12 items-center gap-3 text-sm",
              item.section === active
                ? "border-l-[3px] border-sidebar-ring bg-sidebar-accent pr-6 pl-[21px] font-extrabold text-sidebar-accent-foreground"
                : "px-6 font-semibold hover:text-sidebar-accent-foreground",
            ]}
          >
            {item.section === AdminSection.SNEAKERS ? (
              <ShoeIcon />
            ) : item.section === AdminSection.USERS ? (
              <UsersIcon />
            ) : (
              <LayersIcon />
            )}
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="flex flex-col gap-4 px-6">
    <a
      href="/"
      class="flex items-center gap-2 text-xs font-bold tracking-[0.06em] uppercase opacity-70 hover:opacity-100"
    >
      <ExternalLinkIcon />
      Ver la tienda
    </a>

    {
      user && (
        <div class="flex items-center gap-3 border-t border-sidebar-border pt-4">
          <span class="flex size-10 shrink-0 items-center justify-center bg-primary text-sm font-extrabold text-primary-foreground">
            {initialsOf(user.name)}
          </span>
          <div class="flex min-w-0 flex-col">
            <span class="truncate text-[13px] font-bold text-sidebar-accent-foreground">
              {user.name}
            </span>
            <span class="text-[11px] opacity-60">{ROLE_LABELS[user.role]}</span>
          </div>
        </div>
      )
    }

    <form method="post" action={LOGOUT_PATH}>
      <button
        type="submit"
        class="flex items-center gap-2 text-xs font-bold tracking-[0.06em] uppercase opacity-70 hover:opacity-100"
      >
        <LogoutIcon />
        Cerrar sesión
      </button>
    </form>
  </div>
</aside>
