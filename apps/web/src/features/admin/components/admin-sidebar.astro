---
import {
  initialsOf,
  navFor,
  type AdminNavKey,
} from "@/features/admin/content/nav"
import { LOGOUT_PATH, ROLE_LABELS } from "@/features/auth/api/permissions"
import { STORE_NAME } from "@/features/storefront/content/store"

interface Props {
  active: AdminNavKey
}

const { active } = Astro.props
const user = Astro.locals.user
---

<aside
  class="hidden flex-col justify-between bg-sidebar py-6 text-sidebar-foreground lg:flex"
>
  <div class="flex flex-col gap-7">
    <div class="flex flex-col gap-1 px-6">
      <span
        class="font-display text-2xl leading-none font-extrabold tracking-[0.2em] text-sidebar-accent-foreground"
      >
        {STORE_NAME}
      </span>
      <span
        class="text-[10px] font-extrabold tracking-[0.2em] uppercase opacity-60"
      >
        Panel de gestión
      </span>
    </div>

    <nav class="flex flex-col gap-0.5" aria-label="Secciones del panel">
      {
        navFor(user).map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? "page" : undefined}
            class:list={[
              "flex h-12 items-center gap-3 text-sm",
              item.key === active
                ? "border-l-[3px] border-sidebar-ring bg-sidebar-accent pr-6 pl-[21px] font-extrabold text-sidebar-accent-foreground"
                : "px-6 font-semibold hover:text-sidebar-accent-foreground",
            ]}
          >
            {item.key === "sneakers" ? (
              <svg
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 15c0-4 2-7 5-7 2 0 3 1.4 3.7 3 .7 1.6 2 2.4 3.6 2.4H18c2 0 3 1 3 2.6V17H3Z" />
              </svg>
            ) : item.key === "usuarios" ? (
              <svg
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="9" cy="8" r="3.5" />
                <path d="M3 19.5c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" />
                <path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14.4c1.8.6 3 2.3 3 4.6" />
              </svg>
            ) : (
              <svg
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 7.5 12 3.5l8 4-8 4Z" />
                <path d="m4 12.5 8 4 8-4" />
              </svg>
            )}
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="flex flex-col gap-4 px-6">
    <a
      href="/"
      class="flex items-center gap-2 text-xs font-bold tracking-[0.06em] uppercase opacity-70 hover:opacity-100"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 4h6v6M20 4l-8.5 8.5"></path>
        <path
          d="M18 14v5a1.5 1.5 0 0 1-1.5 1.5H5.5A1.5 1.5 0 0 1 4 19V7.5A1.5 1.5 0 0 1 5.5 6H10"
        ></path>
      </svg>
      Ver la tienda
    </a>

    {
      user && (
        <div class="flex items-center gap-3 border-t border-sidebar-border pt-4">
          <span class="flex size-10 shrink-0 items-center justify-center bg-primary text-sm font-extrabold text-primary-foreground">
            {initialsOf(user.name)}
          </span>
          <div class="flex min-w-0 flex-col">
            <span class="truncate text-[13px] font-bold text-sidebar-accent-foreground">
              {user.name}
            </span>
            <span class="text-[11px] opacity-60">{ROLE_LABELS[user.role]}</span>
          </div>
        </div>
      )
    }

    <form method="post" action={LOGOUT_PATH}>
      <button
        type="submit"
        class="flex items-center gap-2 text-xs font-bold tracking-[0.06em] uppercase opacity-70 hover:opacity-100"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 20H6a1.5 1.5 0 0 1-1.5-1.5v-13A1.5 1.5 0 0 1 6 4h8"
          ></path>
          <path d="M17 8.5 20.5 12 17 15.5M10 12h10.5"></path>
        </svg>
        Cerrar sesión
      </button>
    </form>
  </div>
</aside>
