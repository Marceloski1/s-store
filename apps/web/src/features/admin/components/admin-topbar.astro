---
import { ChevronRightIcon } from "@workspace/ui/components/icons/chevron-right"
import { ExternalLinkIcon } from "@workspace/ui/components/icons/external-link"
import { SearchIcon } from "@workspace/ui/components/icons/search"

import { navFor, type AdminSection } from "@/features/admin/content/nav"

interface Props {
  active: AdminSection
  breadcrumb: { label: string; href?: string }[]
}

const { active, breadcrumb } = Astro.props
---

<div class="border-b border-border bg-card">
  <div class="flex h-[68px] items-center justify-between gap-4 px-4 sm:px-8">
    <nav
      aria-label="Ruta de navegación"
      class="flex items-center gap-2 text-[13px] font-semibold"
    >
      {
        breadcrumb.map((crumb, index) => (
          <>
            {index > 0 && <ChevronRightIcon className="text-border" />}
            {crumb.href ? (
              <a
                href={crumb.href}
                class="text-muted-foreground hover:text-primary"
              >
                {crumb.label}
              </a>
            ) : (
              <span class="font-bold text-foreground">{crumb.label}</span>
            )}
          </>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <form action="/admin" method="get" class="hidden md:block">
        <label for="admin-search" class="sr-only">Buscar en el panel</label>
        <div
          class="flex h-11 w-[300px] items-center gap-2 border border-border bg-muted px-3"
        >
          <SearchIcon size={16} className="text-muted-foreground" />
          <input
            id="admin-search"
            type="search"
            name="q"
            placeholder="Modelo, slug o SKU"
            class="w-full bg-transparent text-[13px] outline-none placeholder:text-muted-foreground"
          />
        </div>
      </form>
      <a
        href="/"
        class="flex h-11 items-center gap-2 border border-border px-3 text-xs font-bold text-foreground hover:bg-muted"
      >
        <ExternalLinkIcon />
        <span class="hidden sm:inline">Ver la tienda</span>
      </a>
    </div>
  </div>

  <nav
    class="flex gap-6 overflow-x-auto border-t border-border px-4 py-3 text-xs font-bold tracking-[0.08em] uppercase sm:px-8 lg:hidden"
    aria-label="Secciones del panel"
  >
    {
      navFor(Astro.locals.user).map((item) => (
        <a
          href={item.href}
          class:list={[
            "shrink-0",
            item.section === active
              ? "text-primary underline"
              : "text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</div>
