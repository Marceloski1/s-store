---
import { ChevronLeftIcon } from "@workspace/ui/components/icons/chevron-left"
import { ChevronRightIcon } from "@workspace/ui/components/icons/chevron-right"

interface Props {
  page: number
  pages: number
  total: number
  shown: number
  previousHref: string | null
  nextHref: string | null
  pageSize: number
}

const { page, pages, total, shown, previousHref, nextHref, pageSize } = Astro.props

const linkClass =
  "flex size-9 items-center justify-center border border-border bg-card text-foreground hover:border-primary"
const disabledClass =
  "flex size-9 items-center justify-center border border-border bg-muted text-muted-foreground"
---

<div
  class="flex flex-wrap items-center justify-between gap-3 border-t border-border p-4"
>
  <div class="flex items-center gap-4">
    <span class="text-[13px] text-muted-foreground">
    {shown} de {total} modelos · página {page} de {pages}
    </span>
    <label class="flex items-center gap-2 text-xs font-bold text-muted-foreground">
      Filas
      <select data-page-size class="h-9 border border-input bg-background px-2 text-xs font-semibold text-foreground outline-none focus-visible:border-ring">
        {[10, 20, 50].map((size) => <option value={size} selected={size === pageSize}>{size}</option>)}
      </select>
    </label>
  </div>
  <div class="flex items-center gap-2">
    {
      previousHref ? (
        <a href={previousHref} aria-label="Página anterior" class={linkClass}>
          <ChevronLeftIcon />
        </a>
      ) : (
        <span aria-hidden="true" class={disabledClass}>
          <ChevronLeftIcon />
        </span>
      )
    }
    <span
      aria-current="page"
      class="flex size-9 items-center justify-center border border-primary bg-primary text-[13px] font-extrabold text-primary-foreground"
    >
      {page}
    </span>
    {
      nextHref ? (
        <a href={nextHref} aria-label="Página siguiente" class={linkClass}>
          <ChevronRightIcon size={15} />
        </a>
      ) : (
        <span aria-hidden="true" class={disabledClass}>
          <ChevronRightIcon size={15} />
        </span>
      )
    }
  </div>
</div>
<script>
  document.querySelectorAll<HTMLSelectElement>("[data-page-size]").forEach((select) => {
    select.addEventListener("change", () => {
      const url = new URL(window.location.href)
      url.searchParams.set("size", select.value)
      url.searchParams.delete("page")
      window.location.assign(url)
    })
  })
</script>
