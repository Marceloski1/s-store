---
import { ACCENT_TONE_BORDER_CLASSES, AccentTone } from "@workspace/ui/lib/tones"

interface Props {
  label: string
  value: number | string
  detail: string
  tone?: AccentTone
}

const { label, value, detail, tone = AccentTone.PRIMARY } = Astro.props
---

<div
  class:list={[
    "flex flex-col gap-1.5 border border-t-[3px] border-border bg-card p-5",
    ACCENT_TONE_BORDER_CLASSES[tone],
  ]}
>
  <span
    class="text-[11px] font-extrabold tracking-[0.14em] text-muted-foreground uppercase"
  >
    {label}
  </span>
  <span class="text-3xl leading-none font-extrabold text-foreground"
    >{value}</span
  >
  <span class="text-xs text-muted-foreground">{detail}</span>
</div>
