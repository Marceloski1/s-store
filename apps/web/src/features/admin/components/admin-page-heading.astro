---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="flex flex-col gap-1.5">
    <h1
      class="font-display text-3xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-4xl"
    >
      {title}
    </h1>
    {subtitle && <span class="text-sm text-muted-foreground">{subtitle}</span>}
  </div>
  <slot name="actions" />
</div>
