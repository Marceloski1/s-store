---
import type { CatalogFacets } from "@/features/storefront/api/types"

interface Props {
  facets: CatalogFacets
}

const { facets } = Astro.props
---

<form
  action="/sneakers"
  method="get"
  class="flex flex-col gap-6 border border-border p-5"
  aria-label="Filtros del catálogo"
>
  <span
    class="font-display text-xl font-extrabold tracking-[0.04em] text-foreground uppercase"
  >
    Filtrar
  </span>

  <fieldset class="flex flex-col gap-3">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Marca
    </legend>
    {
      facets.brands.map((brand) => (
        <label class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold">
          <input
            type="checkbox"
            name="brand"
            value={brand.value}
            class="size-4 accent-primary"
          />
          <span class="grow">{brand.label}</span>
          <span class="font-medium text-muted-foreground">{brand.count}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="flex flex-col gap-3 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Tipo de calzado
    </legend>
    {
      facets.categories.map((category) => (
        <label class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold">
          <input
            type="checkbox"
            name="category"
            value={category.value}
            class="size-4 accent-primary"
          />
          <span class="grow">{category.label}</span>
          <span class="font-medium text-muted-foreground">
            {category.count}
          </span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="flex flex-col gap-3 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Para quién
    </legend>
    {
      facets.genders.map((gender) => (
        <label class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold">
          <input
            type="checkbox"
            name="gender"
            value={gender.value}
            class="size-4 accent-primary"
          />
          <span class="grow">{gender.label}</span>
          <span class="font-medium text-muted-foreground">{gender.count}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="flex flex-col gap-2.5 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Talla (EU)
    </legend>
    <div class="grid grid-cols-4 gap-2">
      {
        facets.sizes.map((size) => (
          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="size"
              value={size.value}
              class="peer sr-only"
            />
            <span class="flex h-11 items-center justify-center border border-input text-[13px] font-bold peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:ring-1 peer-focus-visible:ring-ring">
              {size.label}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="flex flex-col gap-2.5 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Precio
    </legend>
    <div class="flex items-center gap-2">
      <label for="min-price" class="sr-only">Precio mínimo</label>
      <input
        id="min-price"
        type="number"
        name="min_price"
        min="0"
        step="0.01"
        placeholder="Desde"
        class="h-11 w-full min-w-0 border border-input bg-background px-2.5 text-sm font-semibold outline-none focus-visible:border-ring"
      />
      <span class="text-muted-foreground" aria-hidden="true">—</span>
      <label for="max-price" class="sr-only">Precio máximo</label>
      <input
        id="max-price"
        type="number"
        name="max_price"
        min="0"
        step="0.01"
        placeholder="Hasta"
        class="h-11 w-full min-w-0 border border-input bg-background px-2.5 text-sm font-semibold outline-none focus-visible:border-ring"
      />
    </div>
    <label for="currency" class="text-xs font-semibold text-muted-foreground"
      >Moneda</label
    >
    <select
      id="currency"
      name="currency"
      class="h-11 border border-input bg-background px-2.5 text-sm font-semibold outline-none focus-visible:border-ring"
    >
      {
        facets.currencies.map((currency) => (
          <option value={currency}>{currency}</option>
        ))
      }
    </select>
  </fieldset>

  <fieldset class="flex flex-col gap-2.5 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Color
    </legend>
    <div class="flex flex-wrap gap-2">
      {
        facets.colors.map((color) => (
          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="color"
              value={color.value}
              class="peer sr-only"
            />
            <span
              class="block size-11 border border-input peer-checked:ring-2 peer-checked:ring-primary peer-checked:ring-offset-1 peer-focus-visible:ring-1 peer-focus-visible:ring-ring"
              style={`background-color: ${color.value}`}
              title={color.label}
            />
            <span class="sr-only">{color.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="flex flex-col gap-2.5 border-t border-border pt-5">
    <legend
      class="pb-1 text-[11px] font-extrabold tracking-[0.14em] text-foreground uppercase"
    >
      Código de referencia
    </legend>
    <label for="reference" class="sr-only">Código de referencia</label>
    <input
      id="reference"
      type="text"
      name="reference"
      placeholder="Ej.: ALS-RP2-001"
      class="h-11 border border-input bg-background px-3 text-sm font-semibold outline-none focus-visible:border-ring"
    />
    <label
      class="flex cursor-pointer items-center gap-2.5 pt-1.5 text-sm font-semibold"
    >
      <input
        type="checkbox"
        name="in_stock"
        value="true"
        class="size-4 accent-primary"
      />
      <span>Solo modelos con stock</span>
    </label>
  </fieldset>

  <div class="flex flex-col gap-2 border-t border-border pt-5">
    <button
      type="submit"
      class="h-12 bg-foreground text-xs font-extrabold tracking-[0.09em] text-background uppercase hover:bg-foreground/90"
    >
      Aplicar filtros
    </button>
    <a
      href="/sneakers"
      class="flex h-10 items-center justify-center text-xs font-extrabold tracking-[0.06em] text-muted-foreground uppercase underline"
    >
      Limpiar todo
    </a>
  </div>
</form>
