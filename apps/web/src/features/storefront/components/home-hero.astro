---
import { WhatsappIcon } from "@workspace/ui/components/icons/whatsapp"
import { SurfaceTone } from "@workspace/ui/lib/tones"

import ImagePlaceholder from "@/features/storefront/components/image-placeholder.astro"
import {
  PRIMARY_WHATSAPP,
  STORE_NAME,
} from "@/features/storefront/content/store"
---

<section class="bg-muted">
  <div class="mx-auto grid max-w-[1440px] items-stretch md:grid-cols-2">
    <div
      class="flex flex-col justify-center gap-6 px-4 py-14 sm:px-8 lg:py-20 lg:pr-12 lg:pl-16"
    >
      <span
        class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase"
      >
        Nueva selección
      </span>
      <h1
        class="font-display text-5xl leading-[0.94] font-extrabold tracking-tight text-foreground uppercase sm:text-6xl lg:text-7xl"
      >
        Cada paso, un gesto de cuidado
      </h1>
      <p
        class="max-w-[460px] text-base leading-relaxed text-muted-foreground sm:text-lg"
      >
        Calzado deportivo, elegante y cómodo para acompañarte en tu día a día.
        Cada par refleja nuestra pasión por el estilo, la calidad y la
        comodidad.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="/sneakers"
          class="flex h-14 items-center bg-primary px-7 text-[13px] font-extrabold tracking-[0.09em] text-primary-foreground uppercase hover:bg-primary/90"
        >
          Ver el catálogo
        </a>
        <a
          href={PRIMARY_WHATSAPP.href}
          class="flex h-14 items-center gap-2.5 border-[1.5px] border-foreground px-6 text-[13px] font-extrabold tracking-[0.09em] text-foreground uppercase hover:bg-background"
        >
          <WhatsappIcon />
          Consultar por WhatsApp
        </a>
      </div>
      <p class="text-xs font-semibold text-muted-foreground">
        Sin registro: mira el catálogo y escríbenos cuando encuentres tu par.
      </p>
    </div>

    <div
      class="relative min-h-[320px] overflow-hidden bg-accent lg:min-h-[600px]"
    >
      <span
        class="pointer-events-none absolute top-8 -left-6 font-display text-[120px] leading-none font-extrabold tracking-[0.06em] text-primary/10 select-none lg:text-[190px]"
      >
        {STORE_NAME}
      </span>
      <ImagePlaceholder
        tone={SurfaceTone.NONE}
        class="h-full w-full"
        glyphClass="w-[72%]"
        label="[FOTO PRINCIPAL DE CAMPAÑA]"
      />
    </div>
  </div>
</section>
