---
import { ClockIcon } from "@workspace/ui/components/icons/clock"
import { InstagramIcon } from "@workspace/ui/components/icons/instagram"
import { SearchIcon } from "@workspace/ui/components/icons/search"
import { WhatsappIcon } from "@workspace/ui/components/icons/whatsapp"

import {
  PRIMARY_WHATSAPP,
  SOCIAL_LINKS,
  STORE_HOURS,
  STORE_NAME,
} from "@/features/storefront/content/store"
import {
  STOREFRONT_NAV,
  type StorefrontSection,
} from "@/features/storefront/content/nav"

interface Props {
  active?: StorefrontSection
}

const { active } = Astro.props

const instagram = SOCIAL_LINKS[0]
---

<div class="bg-primary text-primary-foreground">
  <div
    class="mx-auto flex h-10 max-w-[1440px] items-center justify-between gap-4 px-4 text-xs font-semibold sm:px-8 lg:px-16"
  >
    <div class="flex items-center gap-5">
      <span class="flex items-center gap-2">
        <ClockIcon />
        Atención de {STORE_HOURS}
      </span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <span class="hidden sm:inline">Entrega y recogida en La Habana</span>
    </div>
    <div class="flex items-center gap-4">
      <a
        href={instagram.href}
        class="hidden items-center gap-2 hover:underline sm:flex"
      >
        <InstagramIcon size={15} strokeWidth={1.8} />
        {instagram.label}
      </a>
      <a href={PRIMARY_WHATSAPP.href} class="hover:underline">
        WhatsApp {PRIMARY_WHATSAPP.label}
      </a>
    </div>
  </div>
</div>

<header class="border-b border-border bg-background">
  <div
    class="mx-auto flex h-[78px] max-w-[1440px] items-center justify-between gap-6 px-4 sm:px-8 lg:px-16"
  >
    <a
      href="/"
      class="font-display text-2xl font-extrabold tracking-[0.22em] text-foreground sm:text-3xl"
    >
      {STORE_NAME}
    </a>

    <nav
      class="hidden items-center gap-8 text-[13px] font-bold tracking-[0.08em] uppercase lg:flex"
      aria-label="Secciones de la tienda"
    >
      {
        STOREFRONT_NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              "pb-1",
              active === item.section
                ? "border-b-2 border-primary text-primary"
                : "border-b-2 border-transparent text-foreground hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <form action="/sneakers" method="get" class="hidden md:block">
        <label for="site-search" class="sr-only"
          >Buscar por marca, modelo o referencia</label
        >
        <div
          class="flex h-11 w-[250px] items-center gap-2 border border-border bg-muted px-3"
        >
          <SearchIcon className="text-muted-foreground" />
          <input
            id="site-search"
            type="search"
            name="q"
            placeholder="Marca, modelo o #referencia"
            class="w-full bg-transparent text-[13px] text-foreground outline-none placeholder:text-muted-foreground"
          />
        </div>
      </form>

      <a
        href={PRIMARY_WHATSAPP.href}
        class="flex h-11 items-center gap-2 bg-primary px-4 text-xs font-extrabold tracking-[0.07em] text-primary-foreground uppercase hover:bg-primary/90"
      >
        <WhatsappIcon size={16} />
        <span class="hidden sm:inline">Escríbenos</span>
      </a>
    </div>
  </div>

  <nav
    class="flex gap-6 overflow-x-auto border-t border-border px-4 py-3 text-xs font-bold tracking-[0.08em] uppercase sm:px-8 lg:hidden"
    aria-label="Secciones de la tienda"
  >
    {
      STOREFRONT_NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            "shrink-0",
            active === item.section
              ? "text-primary underline"
              : "text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
