---
import {
  PRIMARY_WHATSAPP,
  SOCIAL_LINKS,
  STORE_HOURS,
  STORE_NAME,
} from "@/features/storefront/content/store"

interface Props {
  active?: "catalogo" | "deportivo" | "elegante" | "diario" | "contacto"
}

const { active } = Astro.props

const navItems = [
  { key: "catalogo", label: "Catálogo", href: "/sneakers" },
  {
    key: "deportivo",
    label: "Deportivo",
    href: "/sneakers?category=deportivo",
  },
  { key: "elegante", label: "Elegante", href: "/sneakers?category=elegante" },
  { key: "diario", label: "Diario", href: "/sneakers?category=diario" },
  { key: "contacto", label: "Contacto", href: "/#contacto" },
] as const

const instagram = SOCIAL_LINKS[0]
---

<div class="bg-primary text-primary-foreground">
  <div
    class="mx-auto flex h-10 max-w-[1440px] items-center justify-between gap-4 px-4 text-xs font-semibold sm:px-8 lg:px-16"
  >
    <div class="flex items-center gap-5">
      <span class="flex items-center gap-2">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="8.5"></circle>
          <path d="M12 7.5V12l3.2 2"></path>
        </svg>
        Atención de {STORE_HOURS}
      </span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <span class="hidden sm:inline">Entrega y recogida en La Habana</span>
    </div>
    <div class="flex items-center gap-4">
      <a
        href={instagram.href}
        class="hidden items-center gap-2 hover:underline sm:flex"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        {instagram.label}
      </a>
      <a href={PRIMARY_WHATSAPP.href} class="hover:underline">
        WhatsApp {PRIMARY_WHATSAPP.label}
      </a>
    </div>
  </div>
</div>

<header class="border-b border-border bg-background">
  <div
    class="mx-auto flex h-[78px] max-w-[1440px] items-center justify-between gap-6 px-4 sm:px-8 lg:px-16"
  >
    <a
      href="/"
      class="font-display text-2xl font-extrabold tracking-[0.22em] text-foreground sm:text-3xl"
    >
      {STORE_NAME}
    </a>

    <nav
      class="hidden items-center gap-8 text-[13px] font-bold tracking-[0.08em] uppercase lg:flex"
      aria-label="Secciones de la tienda"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "pb-1",
              active === item.key
                ? "border-b-2 border-primary text-primary"
                : "border-b-2 border-transparent text-foreground hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <form action="/sneakers" method="get" class="hidden md:block">
        <label for="site-search" class="sr-only"
          >Buscar por marca, modelo o referencia</label
        >
        <div
          class="flex h-11 w-[250px] items-center gap-2 border border-border bg-muted px-3"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            class="text-muted-foreground"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M16.4 16.4 21 21"></path>
          </svg>
          <input
            id="site-search"
            type="search"
            name="q"
            placeholder="Marca, modelo o #referencia"
            class="w-full bg-transparent text-[13px] text-foreground outline-none placeholder:text-muted-foreground"
          />
        </div>
      </form>

      <a
        href={PRIMARY_WHATSAPP.href}
        class="flex h-11 items-center gap-2 bg-primary px-4 text-xs font-extrabold tracking-[0.07em] text-primary-foreground uppercase hover:bg-primary/90"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.7-5A8.4 8.4 0 1 1 21 11.5Z"
          ></path>
          <path d="M8.9 9.3c0 3 2.4 5.4 5.4 5.4"></path>
        </svg>
        <span class="hidden sm:inline">Escríbenos</span>
      </a>
    </div>
  </div>

  <nav
    class="flex gap-6 overflow-x-auto border-t border-border px-4 py-3 text-xs font-bold tracking-[0.08em] uppercase sm:px-8 lg:hidden"
    aria-label="Secciones de la tienda"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "shrink-0",
            active === item.key ? "text-primary underline" : "text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
