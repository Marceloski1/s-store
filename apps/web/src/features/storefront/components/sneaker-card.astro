---
import SneakerPhoto from "@/features/storefront/components/sneaker-photo.astro"
import {
  formatMoney,
  type SneakerSummary,
} from "@/features/storefront/api/types"

type Tone = "tint" | "soft"

interface Props {
  sneaker: SneakerSummary
  tone?: Tone
  imageClass?: string
}

const { sneaker, tone = "tint", imageClass = "h-[320px]" } = Astro.props

const badges = {
  new: { label: "Nuevo", class: "bg-foreground text-background" },
  "last-sizes": {
    label: "Últimas tallas",
    class: "bg-primary text-primary-foreground",
  },
  "sold-out": {
    label: "Sin stock",
    class: "bg-muted-foreground text-background",
  },
} as const

const badge = sneaker.badge ? badges[sneaker.badge] : null
const soldOut = sneaker.badge === "sold-out"
---

<a
  href={`/sneakers/${sneaker.slug}`}
  class="group flex flex-col border border-border bg-card transition-colors hover:border-primary"
>
  <div class="relative">
    <SneakerPhoto
      image={sneaker.image}
      width={480}
      tone={tone}
      class={soldOut ? `${imageClass} opacity-60` : imageClass}
      glyphClass={soldOut ? "w-[70%] opacity-50" : "w-[70%]"}
      label={sneaker.image ? undefined : "[FOTO]"}
    />
    {
      badge && (
        <span
          class:list={[
            "absolute top-3 left-3 px-2.5 py-1.5 text-[10px] font-extrabold tracking-[0.12em] uppercase",
            badge.class,
          ]}
        >
          {badge.label}
        </span>
      )
    }
  </div>

  <div class="flex flex-col gap-1.5 p-4">
    <span
      class="text-[10px] font-extrabold tracking-[0.14em] text-muted-foreground uppercase"
    >
      {sneaker.brand} · {sneaker.category}
    </span>
    <span class="text-[17px] font-bold text-foreground">{sneaker.name}</span>
    <span class="text-xs font-semibold text-muted-foreground">
      Ref. {sneaker.reference} · {sneaker.sizeRange}
    </span>

    {
      sneaker.colorCodes.length > 0 && (
        <div class="flex gap-1.5 pt-1">
          {sneaker.colorCodes.map((code) => (
            <span
              class="size-4 border border-border"
              style={`background-color: ${code}`}
              aria-hidden="true"
            />
          ))}
        </div>
      )
    }

    <span
      class:list={[
        "pt-1.5 text-[19px] font-extrabold",
        soldOut ? "text-muted-foreground" : "text-foreground",
      ]}
    >
      {formatMoney(sneaker.price)}
    </span>
  </div>
</a>
