---
import { BoltIcon } from "@workspace/ui/components/icons/bolt"
import { PackageIcon } from "@workspace/ui/components/icons/package"
import { StopwatchIcon } from "@workspace/ui/components/icons/stopwatch"
import { WavesIcon } from "@workspace/ui/components/icons/waves"

import type { SpecSheet } from "@/features/storefront/api/types"

interface Props {
  specs: SpecSheet
}

const { specs } = Astro.props

const entries = [
  { label: "Material", value: specs.material, Icon: PackageIcon },
  { label: "Tecnología", value: specs.technology, Icon: BoltIcon },
  { label: "Peso", value: specs.weight, Icon: StopwatchIcon },
  { label: "Amortiguación", value: specs.cushioning, Icon: WavesIcon },
]
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    entries.map(({ label, value, Icon }) => (
      <div class="flex flex-col gap-2.5 border border-border bg-card p-5">
        <Icon className="text-primary" />
        <span class="text-[11px] font-extrabold tracking-[0.14em] text-muted-foreground uppercase">
          {label}
        </span>
        <span class="text-base leading-snug font-bold text-foreground">
          {value}
        </span>
      </div>
    ))
  }
</div>
