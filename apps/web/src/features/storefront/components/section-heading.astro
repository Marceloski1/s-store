---
import { ChevronRightIcon } from "@workspace/ui/components/icons/chevron-right"

interface Props {
  eyebrow?: string
  title: string
  linkLabel?: string
  linkHref?: string
  class?: string
}

const {
  eyebrow,
  title,
  linkLabel,
  linkHref,
  class: className = "",
} = Astro.props
---

<div class:list={["flex flex-wrap items-end justify-between gap-4", className]}>
  <div class="flex flex-col gap-2">
    {
      eyebrow && (
        <span class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase">
          {eyebrow}
        </span>
      )
    }
    <h2
      class="font-display text-3xl font-extrabold tracking-tight text-foreground uppercase sm:text-4xl"
    >
      {title}
    </h2>
  </div>
  {
    linkLabel && linkHref && (
      <a
        href={linkHref}
        class="flex items-center gap-2 text-xs font-extrabold tracking-[0.1em] text-primary uppercase hover:underline"
      >
        {linkLabel}
        <ChevronRightIcon size={15} strokeWidth={2.1} />
      </a>
    )
  }
</div>
