---
import {
  getSneakerBySlug,
  listRelated,
} from "@/features/storefront/api/sneakers"
import Breadcrumb from "@/features/storefront/components/breadcrumb.astro"
import RelatedSneakers from "@/features/storefront/components/related-sneakers.astro"
import SneakerFeatures from "@/features/storefront/components/sneaker-features.astro"
import SneakerGallery from "@/features/storefront/components/sneaker-gallery.astro"
import SneakerNotFound from "@/features/storefront/components/sneaker-not-found.astro"
import { SneakerPurchasePanel } from "@/features/storefront/components/sneaker-purchase-panel"
import SneakerUsage from "@/features/storefront/components/sneaker-usage.astro"
import { StorefrontSection } from "@/features/storefront/content/nav"
import StorefrontLayout from "@/layouts/storefront.astro"

const { slug } = Astro.params
const sneaker = await getSneakerBySlug(slug ?? "")

if (!sneaker) {
  Astro.response.status = 404
}

const related = sneaker ? await listRelated(sneaker, 4) : []
const description = sneaker
  ? [
      `${sneaker.name} de ${sneaker.brand}.`,
      sneaker.usage || sneaker.description,
    ]
      .filter(Boolean)
      .join(" ")
  : "El modelo que buscas no está disponible en el catálogo."
---

<StorefrontLayout
  title={sneaker?.name ?? "Modelo no encontrado"}
  description={description}
  active={StorefrontSection.CATALOG}
>
  {
    sneaker ? (
      <>
        <div class="mx-auto max-w-[1440px] px-4 pt-6 sm:px-8 lg:px-16">
          <Breadcrumb
            wrap
            items={[
              { label: "Inicio", href: "/" },
              { label: "Catálogo", href: "/sneakers" },
              { label: sneaker.name },
            ]}
          />
        </div>

        <section class="mx-auto grid max-w-[1440px] items-start gap-14 px-4 py-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_470px] lg:px-16">
          <SneakerGallery sneaker={sneaker} />
          <SneakerPurchasePanel sneaker={sneaker} client:load />
        </section>

        <SneakerFeatures sneaker={sneaker} />
        <SneakerUsage sneaker={sneaker} />
        <RelatedSneakers sneakers={related} />
      </>
    ) : (
      <SneakerNotFound />
    )
  }
</StorefrontLayout>
