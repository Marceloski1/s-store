---
import { getFacets, listSneakers } from "@/features/storefront/api/sneakers"
import CatalogFilters from "@/features/storefront/components/catalog-filters.astro"
import SneakerCard from "@/features/storefront/components/sneaker-card.astro"
import StorefrontLayout from "@/layouts/storefront.astro"

const params = Astro.url.searchParams
const page = Number(params.get("page") ?? "1")
const query = params.get("q") ?? ""

const [catalog, facets] = await Promise.all([
  listSneakers(page, 9),
  getFacets(),
])

// TODO(003): aplicar los filtros de la query contra el backend; hoy el listado devuelve el catálogo completo
const activeFilters = [
  ...params
    .getAll("brand")
    .map((value) => ({ key: "brand", value, label: value })),
  ...params
    .getAll("category")
    .map((value) => ({ key: "category", value, label: value })),
  ...params
    .getAll("gender")
    .map((value) => ({ key: "gender", value, label: value })),
  ...params
    .getAll("size")
    .map((value) => ({ key: "size", value, label: `Talla EU ${value}` })),
]

const sortOptions = [
  { value: "created_at", label: "Más recientes" },
  { value: "price_asc", label: "Precio: de menor a mayor" },
  { value: "price_desc", label: "Precio: de mayor a menor" },
  { value: "name", label: "Nombre: A – Z" },
  { value: "release_date", label: "Fecha de lanzamiento" },
]

const currentSort = params.get("sort") ?? "created_at"

const shownFrom = catalog.items.length === 0 ? 0 : 1
const resultsLabel = `Mostrando ${shownFrom} – ${catalog.items.length} de ${catalog.total} modelos`
---

<StorefrontLayout
  title="Catálogo"
  description="Explora el catálogo de ALESA: calzado deportivo, elegante y cómodo. Filtra por marca, talla, precio y tipo de calzado."
  active="catalogo"
>
  <div class="mx-auto max-w-[1440px] px-4 pt-8 sm:px-8 lg:px-16">
    <nav
      aria-label="Ruta de navegación"
      class="flex items-center gap-2 text-xs font-semibold"
    >
      <a href="/" class="text-muted-foreground hover:text-primary">Inicio</a>
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-border"
        aria-hidden="true"
      >
        <path d="m9.5 6 6 6-6 6"></path>
      </svg>
      <span class="text-foreground">Catálogo</span>
    </nav>

    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h1
        class="font-display text-4xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-5xl lg:text-[58px]"
      >
        Calzado deportivo
      </h1>
      <span class="pb-2 text-sm font-semibold text-muted-foreground">
        {catalog.total} modelos · {catalog.items.length} mostrados
      </span>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-[1440px] flex-col gap-4 px-4 pt-6 sm:px-8 lg:flex-row lg:items-center lg:px-16"
  >
    <form
      action="/sneakers"
      method="get"
      class="flex grow flex-col gap-3 sm:flex-row sm:items-center"
    >
      <div
        class="flex h-12 grow items-center gap-2.5 border border-border bg-muted px-4"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          class="text-muted-foreground"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M16.4 16.4 21 21"></path>
        </svg>
        <label for="catalog-search" class="sr-only">
          Buscar por marca, modelo o referencia
        </label>
        <input
          id="catalog-search"
          type="search"
          name="q"
          value={query}
          placeholder="Marca, modelo o #referencia"
          class="w-full bg-transparent text-sm font-medium text-foreground outline-none placeholder:text-muted-foreground"
        />
      </div>
      <div class="flex w-full items-center gap-3 sm:w-auto">
        <label
          for="catalog-sort"
          class="text-xs font-extrabold tracking-[0.08em] text-muted-foreground uppercase"
        >
          Ordenar
        </label>
        <select
          id="catalog-sort"
          name="sort"
          class="h-12 w-full min-w-0 grow border border-border bg-background px-3 text-sm font-semibold outline-none focus-visible:border-ring sm:w-[240px] sm:grow-0"
        >
          {
            sortOptions.map((option) => (
              <option
                value={option.value}
                selected={option.value === currentSort}
              >
                {option.label}
              </option>
            ))
          }
        </select>
        <button
          type="submit"
          class="h-12 shrink-0 border-[1.5px] border-foreground px-4 text-xs font-extrabold tracking-[0.08em] text-foreground uppercase hover:bg-muted"
        >
          Buscar
        </button>
      </div>
    </form>
  </div>

  {
    activeFilters.length > 0 && (
      <div class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-2.5 px-4 pt-5 sm:px-8 lg:px-16">
        <span class="text-[11px] font-extrabold tracking-[0.14em] text-muted-foreground uppercase">
          Filtros activos
        </span>
        {activeFilters.map((filter) => (
          <span class="flex h-9 items-center gap-2 border border-accent bg-accent px-3 text-[13px] font-bold text-primary">
            {filter.label}
          </span>
        ))}
        <a
          href="/sneakers"
          class="text-xs font-extrabold tracking-[0.06em] text-muted-foreground uppercase underline"
        >
          Limpiar todo
        </a>
      </div>
    )
  }

  <div
    class="mx-auto grid max-w-[1440px] items-start gap-10 px-4 py-8 sm:px-8 lg:grid-cols-[264px_minmax(0,1fr)] lg:px-16"
  >
    <aside>
      <CatalogFilters facets={facets} />
    </aside>

    {
      catalog.items.length === 0 ? (
        <div class="flex flex-col items-center gap-3 border border-dashed border-border py-24 text-center">
          <span class="font-display text-2xl font-extrabold uppercase">
            Sin resultados
          </span>
          <p class="max-w-[360px] text-sm text-muted-foreground">
            No encontramos modelos con esos filtros. Prueba con menos criterios
            o escríbenos y te ayudamos a buscar.
          </p>
          <a
            href="/sneakers"
            class="mt-2 flex h-12 items-center bg-primary px-6 text-xs font-extrabold tracking-[0.08em] text-primary-foreground uppercase"
          >
            Ver todo el catálogo
          </a>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {catalog.items.map((sneaker, index) => (
            <SneakerCard
              sneaker={sneaker}
              tone={index % 2 === 0 ? "tint" : "soft"}
            />
          ))}
        </div>
      )
    }
  </div>

  <div class="mx-auto max-w-[1440px] px-4 pb-16 sm:px-8 lg:px-16">
    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6"
    >
      <span class="text-[13px] font-semibold text-muted-foreground">
        {resultsLabel}
      </span>
      <nav aria-label="Paginación" class="flex items-center gap-2">
        {
          Array.from({ length: catalog.pages }, (_, index) => index + 1).map(
            (number) => (
              <a
                href={`/sneakers?page=${number}`}
                aria-current={number === catalog.page ? "page" : undefined}
                class:list={[
                  "flex h-11 min-w-11 items-center justify-center border text-sm font-bold",
                  number === catalog.page
                    ? "border-primary bg-primary text-primary-foreground"
                    : "border-border bg-background text-foreground hover:border-primary",
                ]}
              >
                {number}
              </a>
            )
          )
        }
      </nav>
    </div>
  </div>
</StorefrontLayout>
