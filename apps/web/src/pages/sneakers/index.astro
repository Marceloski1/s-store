---
import {
  activeFilterChips,
  catalogHref,
  parseCatalogQuery,
  preservedSearchFields,
} from "@/features/storefront/api/catalog-query"
import { getFacets, listSneakers } from "@/features/storefront/api/sneakers"
import type {
  CatalogFacets,
  CatalogPage,
} from "@/features/storefront/api/types"
import ActiveFilters from "@/features/storefront/components/active-filters.astro"
import Breadcrumb from "@/features/storefront/components/breadcrumb.astro"
import CatalogFilters from "@/features/storefront/components/catalog-filters.astro"
import CatalogPagination from "@/features/storefront/components/catalog-pagination.astro"
import CatalogResults from "@/features/storefront/components/catalog-results.astro"
import CatalogSearchBar from "@/features/storefront/components/catalog-search-bar.astro"
import { sectionForCategories } from "@/features/storefront/content/nav"
import StorefrontLayout from "@/layouts/storefront.astro"

const query = parseCatalogQuery(Astro.url.searchParams)

let catalog: CatalogPage = {
  items: [],
  total: 0,
  page: query.page,
  size: 0,
  pages: 1,
}
let facets: CatalogFacets = {
  brands: [],
  categories: [],
  genders: [],
  sizes: [],
  colors: [],
  currencies: [],
}
let loadFailed = false

try {
  ;[catalog, facets] = await Promise.all([listSneakers(query), getFacets()])
} catch {
  loadFailed = true
  Astro.response.status = 503
}

const firstShown =
  catalog.items.length === 0 ? 0 : (catalog.page - 1) * catalog.size + 1
const lastShown =
  catalog.items.length === 0 ? 0 : firstShown + catalog.items.length - 1
const pages = Array.from({ length: catalog.pages }, (_, index) => ({
  number: index + 1,
  href: catalogHref(query, { page: index + 1 }),
}))
---

<StorefrontLayout
  title="Catálogo"
  description="Explora el catálogo de ALESA: calzado deportivo, elegante y cómodo. Filtra por marca, talla, precio y tipo de calzado."
  active={sectionForCategories(query.categories)}
>
  <div class="mx-auto max-w-[1440px] px-4 pt-8 sm:px-8 lg:px-16">
    <Breadcrumb
      items={[{ label: "Inicio", href: "/" }, { label: "Catálogo" }]}
    />

    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h1
        class="font-display text-4xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-5xl lg:text-[58px]"
      >
        Calzado deportivo
      </h1>
      <span class="pb-2 text-sm font-semibold text-muted-foreground">
        {catalog.total} modelos · {catalog.items.length} mostrados
      </span>
    </div>
  </div>

  <CatalogSearchBar
    q={query.q}
    sort={query.sort}
    preservedFields={preservedSearchFields(query)}
  />

  <ActiveFilters filters={activeFilterChips(query, facets)} />

  <div id="catalog-layout" class="relative mx-auto grid max-w-[1440px] items-start gap-10 px-4 py-8 sm:px-8 lg:grid-cols-[264px_minmax(0,1fr)] lg:px-16">
    <button
      type="button"
      id="filters-toggle"
      class="mb-4 flex h-11 items-center justify-center border border-border bg-background px-4 text-xs font-extrabold tracking-[0.08em] text-foreground uppercase transition hover:border-primary hover:text-primary lg:col-span-2 lg:justify-self-start"
      aria-expanded="true"
      aria-controls="catalog-filters-panel"
    >
      Ocultar filtros
    </button>
    <div id="catalog-filters-backdrop" class="pointer-events-none fixed inset-0 z-20 bg-foreground/20 opacity-0 transition-opacity duration-300 lg:hidden" aria-hidden="true"></div>
    <aside id="catalog-filters-panel" class="relative z-30 transition-all duration-300 lg:sticky lg:top-6">
      <CatalogFilters facets={facets} selected={query} />
    </aside>
    <CatalogResults
      items={catalog.items}
      loadFailed={loadFailed}
      retryHref={catalogHref(query)}
    />
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>("#filters-toggle")
    const panel = document.querySelector<HTMLElement>("#catalog-filters-panel")
    const backdrop = document.querySelector<HTMLElement>("#catalog-filters-backdrop")

    function setFiltersOpen(open: boolean) {
      const layout = document.querySelector<HTMLElement>("#catalog-layout")
      if (!toggle || !panel || !backdrop || !layout) return
      toggle.setAttribute("aria-expanded", String(open))
      toggle.textContent = open ? "Ocultar filtros" : "Mostrar filtros"
      panel.classList.toggle("hidden", !open)
      layout.classList.toggle("lg:grid-cols-[264px_minmax(0,1fr)]", open)
      layout.classList.toggle("lg:grid-cols-[minmax(0,1fr)]", !open)
      backdrop.classList.toggle("pointer-events-none", !open)
      backdrop.classList.toggle("opacity-0", !open)
      document.body.classList.toggle("overflow-hidden", open && window.innerWidth < 1024)
    }

    toggle?.addEventListener("click", () => setFiltersOpen(panel?.classList.contains("hidden") ?? false))
    backdrop?.addEventListener("click", () => setFiltersOpen(false))
  </script>

  <CatalogPagination
    label={`Mostrando ${firstShown} – ${lastShown} de ${catalog.total} modelos`}
    current={catalog.page}
    pages={pages}
  />
</StorefrontLayout>
