---
import { AdminSection } from "@/features/admin/content/nav"
import { getAdminStats, listAdminSneakers } from "@/features/admin/api/sneakers"
import {
  formatAdminDate,
  formatAdminMoney,
  STATUS_LABELS,
  type AdminSneakerPage,
  type AdminStats,
  type SneakerStatus,
} from "@/features/admin/api/types"
import StatTile from "@/features/admin/components/stat-tile.astro"
import StatusBadge from "@/features/admin/components/status-badge.astro"
import ImagePlaceholder from "@/features/storefront/components/image-placeholder.astro"
import AdminLayout from "@/layouts/admin.astro"
import { toErrorMessage } from "@/lib/api/errors"

const requestedStatus = Astro.url.searchParams.get("estado")
const statusFilter =
  requestedStatus && requestedStatus in STATUS_LABELS
    ? (requestedStatus as SneakerStatus)
    : null
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1")
const currentPage =
  Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1

let listing: AdminSneakerPage = { rows: [], total: 0, page: 1, pages: 1 }
let stats: AdminStats = {
  total: 0,
  published: 0,
  drafts: 0,
  archived: 0,
  outOfStock: 0,
}
let loadError: string | null = null

try {
  ;[listing, stats] = await Promise.all([
    listAdminSneakers(statusFilter, currentPage),
    getAdminStats(),
  ])
} catch (error) {
  loadError = toErrorMessage(error)
}

const visible = listing.rows

const tabs = [
  { value: null, label: "Todos", count: stats.total },
  { value: "active", label: "Publicados", count: stats.published },
  { value: "draft", label: "Borradores", count: stats.drafts },
  { value: "archived", label: "Archivados", count: stats.archived },
] satisfies { value: SneakerStatus | null; label: string; count: number }[]

function pageHref(page: number): string {
  const params = new URLSearchParams()
  if (statusFilter) params.set("estado", statusFilter)
  if (page > 1) params.set("page", String(page))
  const query = params.toString()
  return query ? `/admin?${query}` : "/admin"
}

// TODO(admin): la exportación y la selección múltiple todavía no tienen acción
const hasPrevious = listing.page > 1
const hasNext = listing.page < listing.pages
---

<AdminLayout
  title="Sneakers"
  active={AdminSection.SNEAKERS}
  breadcrumb={[{ label: "Catálogo" }, { label: "Sneakers" }]}
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <h1
        class="font-display text-3xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-4xl"
      >
        Sneakers
      </h1>
      <span class="text-sm text-muted-foreground">
        {stats.total} modelos en el catálogo · {stats.published} visibles en la tienda
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        disabled
        title="Próximamente"
        class="flex h-11 items-center gap-2 border border-input bg-card px-4 text-xs font-extrabold tracking-[0.06em] text-foreground uppercase hover:bg-muted disabled:opacity-60"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 4v11m0 0-4-4m4 4 4-4"></path>
          <path d="M4 17v2.5h16V17"></path>
        </svg>
        Exportar
      </button>
      <a
        href="/admin/sneakers/nuevo"
        class="flex h-11 items-center gap-2 bg-primary px-5 text-xs font-extrabold tracking-[0.06em] text-primary-foreground uppercase hover:bg-primary/90"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        Nuevo sneaker
      </a>
    </div>
  </div>

  {
    loadError && (
      <p
        role="alert"
        class="border border-destructive/40 bg-destructive/10 px-4 py-3 text-[13px] font-semibold text-destructive"
      >
        No se pudo cargar el catálogo: {loadError}
      </p>
    )
  }

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <StatTile
      label="Total"
      value={stats.total}
      detail="modelos registrados"
      tone="primary"
    />
    <StatTile
      label="Publicados"
      value={stats.published}
      detail="visibles en la tienda"
      tone="success"
    />
    <StatTile
      label="Borradores"
      value={stats.drafts}
      detail="falta foto o tallas"
      tone="warning"
    />
    <StatTile
      label="Sin stock"
      value={stats.outOfStock}
      detail="para reponer o archivar"
      tone="muted"
    />
  </div>

  <div class="flex flex-col border border-border bg-card">
    <div class="flex flex-wrap items-center gap-2 border-b border-border p-4">
      {
        tabs.map((tab) => (
          <a
            href={tab.value ? `/admin?estado=${tab.value}` : "/admin"}
            class:list={[
              "flex h-9 items-center px-3.5 text-xs font-bold tracking-[0.04em]",
              tab.value === statusFilter || (!tab.value && !statusFilter)
                ? "bg-primary text-primary-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {tab.label} {tab.count}
          </a>
        ))
      }
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[1060px] table-fixed border-collapse">
        <thead>
          <tr class="bg-muted text-left">
            <th class="w-12 py-3 pr-0 pl-5">
              <label for="select-all" class="sr-only"
                >Seleccionar todos los modelos</label
              >
              <input
                id="select-all"
                type="checkbox"
                class="size-4 accent-primary"
              />
            </th>
            <th
              class="min-w-[240px] px-3 py-3 text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Modelo
            </th>
            <th
              class="w-28 px-3 py-3 text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Marca
            </th>
            <th
              class="w-26 px-3 py-3 text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Categoría
            </th>
            <th
              class="w-36 px-3 py-3 text-right text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Precio
            </th>
            <th
              class="w-20 px-3 py-3 text-center text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Colores
            </th>
            <th
              class="w-16 px-3 py-3 text-center text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Stock
            </th>
            <th
              class="w-28 px-3 py-3 text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Estado
            </th>
            <th
              class="w-30 px-3 py-3 text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Actualizado
            </th>
            <th
              class="w-16 py-3 pr-5 pl-3 text-right text-[11px] font-extrabold tracking-[0.1em] text-muted-foreground uppercase"
            >
              Editar
            </th>
          </tr>
        </thead>
        <tbody>
          {
            visible.length === 0 && !loadError && (
              <tr class="border-t border-border/60">
                <td
                  colspan="10"
                  class="px-5 py-10 text-center text-sm text-muted-foreground"
                >
                  No hay modelos en esta vista.
                </td>
              </tr>
            )
          }
          {
            visible.map((row) => (
              <tr class="border-t border-border/60">
                <td class="py-3 pr-0 pl-5">
                  <label for={`select-${row.id}`} class="sr-only">
                    Seleccionar {row.name}
                  </label>
                  <input
                    id={`select-${row.id}`}
                    type="checkbox"
                    class="size-4 accent-primary"
                  />
                </td>
                <td class="px-3 py-3">
                  <div class="flex items-center gap-3">
                    {row.imageUrl ? (
                      <img
                        src={row.imageUrl}
                        alt=""
                        loading="lazy"
                        class="size-11 shrink-0 bg-muted object-cover"
                      />
                    ) : (
                      <ImagePlaceholder
                        tone={row.status === "archived" ? "soft" : "tint"}
                        class="size-11 shrink-0"
                        glyphClass="w-[68%]"
                      />
                    )}
                    <div class="flex min-w-0 flex-col gap-0.5">
                      <a
                        href={`/admin/sneakers/${row.slug}`}
                        class="truncate text-sm font-bold text-foreground hover:text-primary"
                      >
                        {row.name}
                      </a>
                      <span class="truncate text-[11px] text-muted-foreground">
                        {row.slug} · {row.sku}
                        {row.warning ? ` · ${row.warning}` : ""}
                      </span>
                    </div>
                  </div>
                </td>
                <td class="px-3 py-3 text-[13px] font-semibold">{row.brand}</td>
                <td class="px-3 py-3 text-[13px] whitespace-nowrap text-muted-foreground">
                  {row.category}
                </td>
                <td class="px-3 py-3 text-right text-[13px] font-bold whitespace-nowrap">
                  {formatAdminMoney(row.price)}
                </td>
                <td class="px-3 py-3 text-center text-[13px]">
                  {row.colorways}
                </td>
                <td
                  class:list={[
                    "px-3 py-3 text-center text-[13px] font-bold",
                    row.stock === 0
                      ? "text-muted-foreground"
                      : "text-foreground",
                  ]}
                >
                  {row.stock}
                </td>
                <td class="px-3 py-3">
                  <StatusBadge status={row.status} />
                </td>
                <td class="px-3 py-3 text-[13px] whitespace-nowrap text-muted-foreground">
                  {formatAdminDate(row.updatedAt)}
                </td>
                <td class="py-3 pr-5 pl-3 text-right">
                  <a
                    href={`/admin/sneakers/${row.slug}`}
                    aria-label={`Editar ${row.name}`}
                    class="inline-flex size-9 items-center justify-center border border-border hover:border-primary hover:text-primary"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 20h4L20 8l-4-4L4 16Z" />
                    </svg>
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-3 border-t border-border p-4"
    >
      <span class="text-[13px] text-muted-foreground">
        {visible.length} de {listing.total} modelos · página {listing.page} de {
          listing.pages
        }
      </span>
      <div class="flex items-center gap-2">
        {
          hasPrevious ? (
            <a
              href={pageHref(listing.page - 1)}
              aria-label="Página anterior"
              class="flex size-9 items-center justify-center border border-border bg-card text-foreground hover:border-primary"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m14.5 6-6 6 6 6" />
              </svg>
            </a>
          ) : (
            <span
              aria-hidden="true"
              class="flex size-9 items-center justify-center border border-border bg-muted text-muted-foreground"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m14.5 6-6 6 6 6" />
              </svg>
            </span>
          )
        }
        <span
          aria-current="page"
          class="flex size-9 items-center justify-center border border-primary bg-primary text-[13px] font-extrabold text-primary-foreground"
        >
          {listing.page}
        </span>
        {
          hasNext ? (
            <a
              href={pageHref(listing.page + 1)}
              aria-label="Página siguiente"
              class="flex size-9 items-center justify-center border border-border bg-card text-foreground hover:border-primary"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m9.5 6 6 6-6 6" />
              </svg>
            </a>
          ) : (
            <span
              aria-hidden="true"
              class="flex size-9 items-center justify-center border border-border bg-muted text-muted-foreground"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9.5 6 6 6-6 6" />
              </svg>
            </span>
          )
        }
      </div>
    </div>
  </div>
</AdminLayout>
