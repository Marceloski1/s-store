---
import { getAdminStats, listAdminSneakers } from "@/features/admin/api/sneakers"
import {
  SneakerStatus,
  type AdminSneakerPage,
  type AdminStats,
  type StatusTab,
} from "@/features/admin/api/types"
import AdminAlert from "@/features/admin/components/admin-alert.astro"
import AdminPageHeading from "@/features/admin/components/admin-page-heading.astro"
import AdminPagination from "@/features/admin/components/admin-pagination.astro"
import SneakerListActions from "@/features/admin/components/sneaker-list-actions.astro"
import SneakerStats from "@/features/admin/components/sneaker-stats.astro"
import SneakersTable from "@/features/admin/components/sneakers-table.astro"
import StatusTabs from "@/features/admin/components/status-tabs.astro"
import { AdminSection } from "@/features/admin/content/nav"
import AdminLayout from "@/layouts/admin.astro"
import { toErrorMessage } from "@/lib/api/errors"
import { toEnum } from "@/lib/enums"

const statusFilter = toEnum(SneakerStatus, Astro.url.searchParams.get("estado"))
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1")
const currentPage =
  Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1

let listing: AdminSneakerPage = { rows: [], total: 0, page: 1, pages: 1 }
let stats: AdminStats = {
  total: 0,
  published: 0,
  drafts: 0,
  archived: 0,
  outOfStock: 0,
}
let loadError: string | null = null

try {
  ;[listing, stats] = await Promise.all([
    listAdminSneakers(statusFilter, currentPage),
    getAdminStats(),
  ])
} catch (error) {
  loadError = toErrorMessage(error)
}

const tabs: StatusTab[] = [
  { value: null, label: "Todos", count: stats.total },
  { value: SneakerStatus.ACTIVE, label: "Publicados", count: stats.published },
  { value: SneakerStatus.DRAFT, label: "Borradores", count: stats.drafts },
  { value: SneakerStatus.ARCHIVED, label: "Archivados", count: stats.archived },
]

function pageHref(page: number): string {
  const params = new URLSearchParams()
  if (statusFilter) params.set("estado", statusFilter)
  if (page > 1) params.set("page", String(page))
  const query = params.toString()
  return query ? `/admin?${query}` : "/admin"
}

// TODO(admin): la exportación y la selección múltiple todavía no tienen acción
---

<AdminLayout
  title="Sneakers"
  active={AdminSection.SNEAKERS}
  breadcrumb={[{ label: "Catálogo" }, { label: "Sneakers" }]}
>
  <AdminPageHeading
    title="Sneakers"
    subtitle={`${stats.total} modelos en el catálogo · ${stats.published} visibles en la tienda`}
  >
    <SneakerListActions slot="actions" />
  </AdminPageHeading>

  {
    loadError && (
      <AdminAlert message={`No se pudo cargar el catálogo: ${loadError}`} />
    )
  }

  <SneakerStats stats={stats} />

  <div class="flex flex-col border border-border bg-card">
    <StatusTabs tabs={tabs} active={statusFilter} />
    <SneakersTable
      rows={listing.rows}
      showEmpty={listing.rows.length === 0 && !loadError}
    />
    <AdminPagination
      page={listing.page}
      pages={listing.pages}
      total={listing.total}
      shown={listing.rows.length}
      previousHref={listing.page > 1 ? pageHref(listing.page - 1) : null}
      nextHref={listing.page < listing.pages
        ? pageHref(listing.page + 1)
        : null}
    />
  </div>
</AdminLayout>
