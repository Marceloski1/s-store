---
import "@workspace/ui/globals.css"

import { safeNextPath } from "@/features/auth/api/permissions"
import LoginBrandPanel from "@/features/auth/components/login-brand-panel.astro"
import LoginPanel from "@/features/auth/components/login-panel.astro"
import { STORE_NAME } from "@/features/storefront/content/store"

const nextPath = safeNextPath(Astro.url.searchParams.get("next"))
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>Acceso al panel · {STORE_NAME}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="grid min-h-screen lg:grid-cols-[620px_minmax(0,1fr)]">
      <LoginBrandPanel />
      <LoginPanel nextPath={nextPath} />
    </div>
  </body>
</html>
