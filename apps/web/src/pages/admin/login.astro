---
import "@workspace/ui/globals.css"

import ImagePlaceholder from "@/features/storefront/components/image-placeholder.astro"
import {
  PRIMARY_WHATSAPP,
  SOCIAL_LINKS,
  STORE_ADDRESSES,
  STORE_HOURS,
  STORE_NAME,
} from "@/features/storefront/content/store"

const perks = [
  "Publica un modelo solo cuando esté completo",
  "Controla el stock talla por talla",
  "Sube las fotos y ordénalas a tu gusto",
]

const instagram = SOCIAL_LINKS[0]
const currentAddress = STORE_ADDRESSES[0]
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>Acceso al panel · {STORE_NAME}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="grid min-h-screen lg:grid-cols-[620px_minmax(0,1fr)]">
      <div
        class="relative hidden flex-col justify-between overflow-hidden bg-primary p-14 text-primary-foreground lg:flex"
      >
        <span
          class="pointer-events-none absolute -bottom-16 -left-12 font-display text-[270px] leading-none font-extrabold tracking-[0.04em] text-primary-foreground/[0.07] select-none"
        >
          {STORE_NAME}
        </span>
        <div
          class="pointer-events-none absolute top-60 -right-10 w-[330px] opacity-[0.14]"
        >
          <ImagePlaceholder
            tone="none"
            class="h-48 text-primary-foreground"
            glyphClass="w-full"
          />
        </div>

        <span
          class="relative font-display text-3xl leading-none font-extrabold tracking-[0.22em]"
        >
          {STORE_NAME}
        </span>

        <div class="relative flex flex-col gap-6">
          <h2
            class="font-display text-5xl leading-[0.98] font-extrabold tracking-tight uppercase"
          >
            El catálogo, bajo control
          </h2>
          <p
            class="max-w-[400px] text-lg leading-relaxed text-primary-foreground/80"
          >
            Desde aquí gestionas los modelos, las marcas, las categorías, las
            tallas y las fotos que ven tus clientes.
          </p>
          <div class="flex flex-col gap-3 pt-1">
            {
              perks.map((perk) => (
                <span class="flex items-center gap-3 text-sm font-semibold">
                  <svg
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                  {perk}
                </span>
              ))
            }
          </div>
        </div>

        <div
          class="relative flex flex-col gap-1 text-[13px] text-primary-foreground/70"
        >
          <span>{currentAddress.value}</span>
          <span>Atención de {STORE_HOURS} · {instagram.label}</span>
        </div>
      </div>

      <div class="flex items-center justify-center p-6 sm:p-14">
        <form class="flex w-full max-w-[400px] flex-col gap-6">
          <div class="flex flex-col gap-2.5">
            <span
              class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase"
            >
              Administración
            </span>
            <h1
              class="font-display text-4xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-5xl"
            >
              Entra al panel
            </h1>
            <p class="text-[15px] leading-relaxed text-muted-foreground">
              Acceso exclusivo para el equipo de {STORE_NAME}. Los clientes no
              necesitan cuenta para ver el catálogo.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="login-email"
              class="text-xs font-extrabold tracking-[0.1em] text-foreground uppercase"
            >
              Correo
            </label>
            <input
              id="login-email"
              type="email"
              autocomplete="username"
              placeholder="tucorreo@alesa.cu"
              class="h-14 border border-input bg-background px-4 text-[15px] font-medium outline-none focus-visible:border-ring"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="login-password"
              class="text-xs font-extrabold tracking-[0.1em] text-foreground uppercase"
            >
              Contraseña
            </label>
            <div class="relative flex items-center">
              <input
                id="login-password"
                type="password"
                autocomplete="current-password"
                class="h-14 w-full border border-input bg-background pr-14 pl-4 text-[15px] font-medium outline-none focus-visible:border-ring"
              />
              <button
                type="button"
                aria-label="Mostrar la contraseña"
                class="absolute right-1.5 flex size-11 items-center justify-center text-muted-foreground hover:text-foreground"
              >
                <svg
                  width="19"
                  height="19"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                  ></path>
                  <circle cx="12" cy="12" r="2.8"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3">
            <label
              for="login-remember"
              class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold"
            >
              <input
                id="login-remember"
                type="checkbox"
                checked
                class="size-4 accent-primary"
              />
              Mantener la sesión abierta
            </label>
            <a
              href="#recuperar"
              class="text-[13px] font-bold text-primary hover:underline"
            >
              ¿Olvidaste la contraseña?
            </a>
          </div>

          <a
            href="/admin"
            class="flex h-14 items-center justify-center bg-primary text-sm font-extrabold tracking-[0.1em] text-primary-foreground uppercase hover:bg-primary/90"
          >
            Entrar
          </a>

          <div
            class="flex items-start gap-3 border border-border bg-muted px-4 py-3.5"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-primary"
              aria-hidden="true"
            >
              <path d="M12 3.5 19 6v6c0 4-3 7-7 8.5C8 19 5 16 5 12V6Z"></path>
              <path d="M12 9v4M12 16h0"></path>
            </svg>
            <span class="text-[13px] leading-relaxed text-muted-foreground">
              Tras cinco intentos fallidos el acceso se bloquea 15 minutos. Si
              no puedes entrar, escribe al <strong class="text-foreground"
                >{PRIMARY_WHATSAPP.label}</strong
              >.
            </span>
          </div>

          <a
            href="/"
            class="flex items-center gap-2 text-[13px] font-bold text-muted-foreground hover:text-primary"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m14.5 6-6 6 6 6"></path>
            </svg>
            Volver a la tienda
          </a>
        </form>
      </div>
    </div>
  </body>
</html>
