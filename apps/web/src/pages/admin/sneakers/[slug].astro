---
import { adminSneakersGateway } from "@/features/admin/api/sneakers"
import { sneakerToForm, toAdminOptions } from "@/features/admin/api/types"
import { SneakerEditor } from "@/features/admin/components/sneaker-editor"
import { CURRENCY_OPTIONS, GENDER_OPTIONS } from "@/features/catalog/api/labels"
import { loadCatalogReferences } from "@/features/catalog/api/references"
import AdminLayout from "@/layouts/admin.astro"

const { slug = "" } = Astro.params

const [sneaker, references] = await Promise.all([
  adminSneakersGateway.getBySlug(slug),
  loadCatalogReferences(),
])

if (!sneaker) {
  Astro.response.status = 404
}
---

{
  sneaker ? (
    <AdminLayout
      title={sneaker.name}
      active="sneakers"
      breadcrumb={[
        { label: "Sneakers", href: "/admin" },
        { label: sneaker.name },
      ]}
    >
      <SneakerEditor
        client:load
        initialSneaker={sneaker}
        initialForm={sneakerToForm(sneaker)}
        brands={toAdminOptions(references.brands)}
        categories={toAdminOptions(references.categories)}
        genders={GENDER_OPTIONS}
        currencies={CURRENCY_OPTIONS}
      />
    </AdminLayout>
  ) : (
    <AdminLayout
      title="Modelo no encontrado"
      active="sneakers"
      breadcrumb={[
        { label: "Sneakers", href: "/admin" },
        { label: "No encontrado" },
      ]}
    >
      <div class="flex flex-col items-start gap-3 border border-dashed border-border bg-card p-8">
        <h1 class="font-display text-3xl leading-none font-extrabold tracking-tight text-foreground uppercase">
          Modelo no encontrado
        </h1>
        <p class="text-sm text-muted-foreground">
          No existe ningún sneaker con el slug «{slug}». Puede que lo hayas
          renombrado o eliminado.
        </p>
        <a
          href="/admin"
          class="flex h-11 items-center bg-primary px-5 text-xs font-extrabold tracking-[0.06em] text-primary-foreground uppercase hover:bg-primary/90"
        >
          Volver a sneakers
        </a>
      </div>
    </AdminLayout>
  )
}
