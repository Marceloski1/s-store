---
import { AdminSection } from "@/features/admin/content/nav"
import { CatalogAdmin } from "@/features/catalog/components/catalog-admin"
import AdminLayout from "@/layouts/admin.astro"
---

<AdminLayout
  title="Marcas y categorías"
  active={AdminSection.BRANDS}
  breadcrumb={[{ label: "Catálogo" }, { label: "Marcas y categorías" }]}
>
  <div class="flex flex-col gap-1.5">
    <h1
      class="font-display text-3xl leading-none font-extrabold tracking-tight text-foreground uppercase sm:text-4xl"
    >
      Marcas y categorías
    </h1>
    <span class="text-sm text-muted-foreground">
      Son las listas que alimentan los filtros del catálogo público. El nombre
      se convierte en slug automáticamente.
    </span>
  </div>

  <div
    class="flex items-start gap-3 border border-warning/40 bg-warning/10 px-4 py-3.5"
  >
    <svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="mt-0.5 shrink-0 text-warning"
      aria-hidden="true"
    >
      <path d="M12 4 21 19H3Z"></path>
      <path d="M12 10v4M12 16.5h0"></path>
    </svg>
    <span class="text-[13px] leading-relaxed text-warning">
      Una marca o categoría con modelos asociados no se puede borrar: la API
      responde 409. Reasigna esos modelos primero o archívalos.
    </span>
  </div>

  <CatalogAdmin client:load />
</AdminLayout>
