---
import MainLayout from "@/layouts/main.astro"
import { CatalogAdmin } from "@/features/catalog/components/catalog-admin"
---

<MainLayout title="Catálogo · pruebas">
  <main class="mx-auto flex max-w-6xl flex-col gap-6 p-6">
    <header class="flex flex-col gap-1">
      <h1 class="text-lg font-medium">Catálogo · entorno de pruebas</h1>
      <p class="text-sm text-muted-foreground">
        CRUD de marcas y categorías contra la API de saury-backend
      </p>
    </header>
    <CatalogAdmin client:load />
  </main>
</MainLayout>
