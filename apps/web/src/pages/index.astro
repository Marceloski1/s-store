---
import { listFeatured } from "@/features/storefront/api/sneakers"
import HomeExperience from "@/features/storefront/components/home-experience.astro"
import HomeFeatured from "@/features/storefront/components/home-featured.astro"
import HomeHero from "@/features/storefront/components/home-hero.astro"
import HomeSearchCriteria from "@/features/storefront/components/home-search-criteria.astro"
import HomeStyles from "@/features/storefront/components/home-styles.astro"
import HomeTestimonial from "@/features/storefront/components/home-testimonial.astro"
import { STORE_INTRO } from "@/features/storefront/content/store"
import StorefrontLayout from "@/layouts/storefront.astro"

const featured = await listFeatured(4).catch(() => [])
---

<StorefrontLayout title="Inicio" description={STORE_INTRO}>
  <HomeHero />
  <HomeStyles />
  <HomeFeatured sneakers={featured} />
  <HomeSearchCriteria />
  <HomeExperience />
  <HomeTestimonial />
</StorefrontLayout>
