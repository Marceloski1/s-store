---
import { SurfaceTone, alternatingTone } from "@workspace/ui/lib/tones"
import { listFeatured } from "@/features/storefront/api/sneakers"
import ImagePlaceholder from "@/features/storefront/components/image-placeholder.astro"
import SectionHeading from "@/features/storefront/components/section-heading.astro"
import SneakerCard from "@/features/storefront/components/sneaker-card.astro"
import {
  PRIMARY_WHATSAPP,
  SEARCH_CRITERIA,
  STORE_INTRO,
  STORE_NAME,
  STORE_STYLES,
  STORE_VALUES,
} from "@/features/storefront/content/store"
import StorefrontLayout from "@/layouts/storefront.astro"

const featured = await listFeatured(4).catch(() => [])
---

<StorefrontLayout title="Inicio" description={STORE_INTRO}>
  <section class="bg-muted">
    <div class="mx-auto grid max-w-[1440px] items-stretch md:grid-cols-2">
      <div
        class="flex flex-col justify-center gap-6 px-4 py-14 sm:px-8 lg:py-20 lg:pr-12 lg:pl-16"
      >
        <span
          class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase"
        >
          Nueva selección
        </span>
        <h1
          class="font-display text-5xl leading-[0.94] font-extrabold tracking-tight text-foreground uppercase sm:text-6xl lg:text-7xl"
        >
          Cada paso, un gesto de cuidado
        </h1>
        <p
          class="max-w-[460px] text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          Calzado deportivo, elegante y cómodo para acompañarte en tu día a día.
          Cada par refleja nuestra pasión por el estilo, la calidad y la
          comodidad.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/sneakers"
            class="flex h-14 items-center bg-primary px-7 text-[13px] font-extrabold tracking-[0.09em] text-primary-foreground uppercase hover:bg-primary/90"
          >
            Ver el catálogo
          </a>
          <a
            href={PRIMARY_WHATSAPP.href}
            class="flex h-14 items-center gap-2.5 border-[1.5px] border-foreground px-6 text-[13px] font-extrabold tracking-[0.09em] text-foreground uppercase hover:bg-background"
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.7-5A8.4 8.4 0 1 1 21 11.5Z"
              ></path>
              <path d="M8.9 9.3c0 3 2.4 5.4 5.4 5.4"></path>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>
        <p class="text-xs font-semibold text-muted-foreground">
          Sin registro: mira el catálogo y escríbenos cuando encuentres tu par.
        </p>
      </div>

      <div
        class="relative min-h-[320px] overflow-hidden bg-accent lg:min-h-[600px]"
      >
        <span
          class="pointer-events-none absolute top-8 -left-6 font-display text-[120px] leading-none font-extrabold tracking-[0.06em] text-primary/10 select-none lg:text-[190px]"
        >
          {STORE_NAME}
        </span>
        <ImagePlaceholder
          tone={SurfaceTone.NONE}
          class="h-full w-full"
          glyphClass="w-[72%]"
          label="[FOTO PRINCIPAL DE CAMPAÑA]"
        />
      </div>
    </div>
  </section>

  <section
    class="mx-auto flex max-w-[1440px] flex-col gap-7 px-4 py-16 sm:px-8 lg:px-16"
  >
    <SectionHeading
      eyebrow="Compra por estilo"
      title="Tres formas de caminar"
      linkLabel="Ver todo"
      linkHref="/sneakers"
    />
    <div class="grid gap-7 md:grid-cols-3">
      {
        STORE_STYLES.map((style, index) => (
          <a
            href={`/sneakers?category=${style.slug}`}
            class="group relative flex h-[264px] items-end overflow-hidden border border-border p-6 transition-colors hover:border-primary"
          >
            <span class="absolute inset-0">
              <ImagePlaceholder
                tone={alternatingTone(index)}
                class="h-full w-full"
                glyphClass="w-[78%] translate-x-10 -translate-y-8"
              />
            </span>
            <div class="relative flex flex-col gap-1.5">
              <span class="font-display text-3xl leading-none font-extrabold text-foreground uppercase">
                {style.name}
              </span>
              <span class="text-[13px] font-semibold text-primary">
                {style.detail}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto flex max-w-[1440px] flex-col gap-7 px-4 pb-16 sm:px-8 lg:px-16"
  >
    <SectionHeading
      eyebrow="Lo más buscado"
      title="Modelos destacados"
      linkLabel="Todo el catálogo"
      linkHref="/sneakers"
    />
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
      {
        featured.map((sneaker, index) => (
          <SneakerCard
            sneaker={sneaker}
            tone={alternatingTone(index)}
            imageClass="h-[300px]"
          />
        ))
      }
    </div>
  </section>

  <section class="border-y border-border bg-muted">
    <div
      class="mx-auto flex max-w-[1440px] flex-col gap-8 px-4 py-12 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-16"
    >
      <div class="flex max-w-[420px] flex-col gap-2">
        <span
          class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase"
        >
          Busca como prefieras
        </span>
        <p class="text-xl leading-snug font-bold text-foreground">
          Encuentra tu par por marca, referencia, precio o tipo de calzado.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          SEARCH_CRITERIA.map((criteria, index) => (
            <a
              href={`/sneakers${criteria.query}`}
              class:list={[
                "flex min-w-[152px] flex-col gap-1.5 border p-4",
                index === SEARCH_CRITERIA.length - 1
                  ? "border-primary bg-primary"
                  : "border-border bg-background",
              ]}
            >
              <span
                class:list={[
                  "text-[10px] font-extrabold tracking-[0.14em] uppercase",
                  index === SEARCH_CRITERIA.length - 1
                    ? "text-primary-foreground/70"
                    : "text-muted-foreground",
                ]}
              >
                {criteria.prefix}
              </span>
              <span
                class:list={[
                  "text-base font-bold",
                  index === SEARCH_CRITERIA.length - 1
                    ? "text-primary-foreground"
                    : "text-foreground",
                ]}
              >
                {criteria.label}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-[1440px] gap-12 px-4 py-16 sm:px-8 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:px-16"
  >
    <div class="flex flex-col gap-4">
      <span
        class="text-[11px] font-extrabold tracking-[0.18em] text-primary uppercase"
      >
        La experiencia {STORE_NAME}
      </span>
      <h2
        class="font-display text-3xl leading-tight font-extrabold tracking-tight text-foreground uppercase sm:text-4xl"
      >
        Un espacio pensado para consentir cada uno de tus pasos
      </h2>
      <p class="text-base leading-relaxed text-muted-foreground">
        Te invitamos a vivir la experiencia {STORE_NAME}, donde cada paso es un
        gesto de cuidado y distinción.
      </p>
    </div>
    <div class="flex flex-col gap-5">
      {
        STORE_VALUES.map((value) => (
          <div class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center bg-accent">
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
                aria-hidden="true"
              >
                <path d="m5 12.5 4.5 4.5L19 7.5" />
              </svg>
            </span>
            <div class="flex flex-col gap-1">
              <span class="text-base font-bold text-foreground">
                {value.title}
              </span>
              <span class="text-sm text-muted-foreground">{value.detail}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-primary">
    <div
      class="mx-auto flex max-w-[1440px] flex-col gap-8 px-4 py-14 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-16"
    >
      <blockquote class="flex max-w-[840px] flex-col gap-4">
        <p
          class="text-2xl leading-snug font-semibold text-primary-foreground sm:text-[27px]"
        >
          «Llegué buscando unos tenis para caminar y salí con el par más cómodo
          que he tenido.»
        </p>
        <footer
          class="text-[13px] font-bold tracking-[0.06em] text-primary-foreground/70 uppercase"
        >
          Dayana R. · Cliente en La Habana · [TESTIMONIO DE EJEMPLO]
        </footer>
      </blockquote>
      <a
        href="https://instagram.com/somos_alesa"
        class="flex h-14 shrink-0 items-center gap-2.5 bg-background px-6 text-[13px] font-extrabold tracking-[0.09em] text-primary uppercase hover:bg-background/90"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          aria-hidden="true"
        >
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        Más reseñas
      </a>
    </div>
  </section>
</StorefrontLayout>
